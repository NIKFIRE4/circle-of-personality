# Application
APP_URL=http://localhost:3000
APP_PORT=3000
NODE_ENV=development

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://balance:balance_dev_password@localhost:55432/life_balance?schema=public
POSTGRES_DB=life_balance
POSTGRES_USER=balance
POSTGRES_PASSWORD=balance_dev_password
POSTGRES_PORT=55432

# Authentication and audit hashing
SESSION_TTL_SECONDS=2592000
BCRYPT_ROUNDS=12
AUDIT_HASH_SECRET=replace-with-at-least-32-random-bytes

# Server-only root key for encrypting iCal/ICS feed URLs at rest.
# It must be exactly 32 random bytes encoded as base64 (with optional
# `base64:` prefix) or 64 hexadecimal chars. Generate with:
# openssl rand -base64 32
# If omitted, the application falls back to GOOGLE_TOKEN_ENCRYPTION_KEY.
CALENDAR_FEED_ENCRYPTION_KEY=base64:replace-with-output-of-openssl-command

# Legacy/optional Google OAuth configuration. It is not required for the main
# read-only Google/Apple iCal feed flow. Keep it for backwards compatibility
# and possible future Google Calendar write access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Server-only root key for legacy OAuth secrets and tokens. It is also the
# compatibility fallback when CALENDAR_FEED_ENCRYPTION_KEY is omitted.
GOOGLE_TOKEN_ENCRYPTION_KEY=base64:replace-with-output-of-openssl-command

# Russian speech-to-text service
SPEECH_SERVICE_URL=http://127.0.0.1:8001
SPEECH_PORT=8001
SPEECH_DEVICE=auto
# Set true only for UI demonstrations without the ML service.
VOICE_DEMO_MODE=false

# AI task interpreter (server-only). Configure ONE provider profile.
#
# OpenRouter: the default is google/gemma-4-31b-it:free. Create a free API
# key in OpenRouter, paste it here, then restart Next.js.
OPENROUTER_API_KEY=
# Existing installations may temporarily use API_KEY instead, but the
# provider-specific name above is preferred.

# GigaChat personal/non-commercial profile (Russia). GIGACHAT_CREDENTIALS is
# the Authorization Key from the developer console, without the word "Basic".
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_MODEL=GigaChat-2
# GigaChat may require the Russian trusted CA bundle to be configured before
# Node starts, for example: NODE_EXTRA_CA_CERTS=C:\path\russian_trusted_ca.pem

# Cloudflare Workers AI recurring free allowance with Qwen. Both values are
# required; the endpoint is assembled from the account id automatically.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=

# Generic OpenAI-compatible override (DeepSeek, Qwen Model Studio, a custom
# gateway, etc.). These values take priority over the profiles above.
# TASK_AI_API_KEY=
# TASK_AI_BASE_URL=https://provider.example/v1
# TASK_AI_MODEL=provider/model-id
TASK_AI_TIMEOUT_MS=20000

# Vercel: set DATABASE_URL, APP_URL, AUDIT_HASH_SECRET and
# CALENDAR_FEED_ENCRYPTION_KEY in Project Settings. Do not upload this file with
# real values. The speech Docker service is not deployed with the Next.js app;
# keep VOICE_DEMO_MODE=true or point SPEECH_SERVICE_URL at a separately hosted
# private service.

# A key is not required for a loopback OpenAI-compatible server:
# TASK_AI_BASE_URL=http://127.0.0.1:8000/v1
# TASK_AI_MODEL=Qwen/Qwen3.5-4B

# Optional demo account for `npm run db:seed`
# SEED_DEMO_EMAIL=demo@example.com
# SEED_DEMO_PASSWORD=replace-with-a-strong-password
# SEED_DEMO_NAME=Demo User
# SEED_DEMO_TIME_ZONE=Europe/Moscow
