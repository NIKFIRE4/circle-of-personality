generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum EventSource {
  MANUAL
  VOICE
  GOOGLE
  APPLE
}

enum CalendarProvider {
  GOOGLE
  APPLE
  MICROSOFT
  CALDAV
}

enum VoiceCommandStatus {
  RECEIVED
  TRANSCRIBING
  PARSED
  APPLIED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(254)
  passwordHash String
  name         String    @db.VarChar(80)
  timeZone     String    @default("Europe/Moscow") @db.VarChar(100)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions             Session[]
  balanceCategories    BalanceCategory[]
  events               Event[]
  goals                Goal[]
  calendarConnections  CalendarConnection[]
  googleCalendarConfig GoogleCalendarConfig?
  voiceCommands        VoiceCommand[]
  auditLogs            AuditLog[]            @relation("AuditActor")
  outboxRecords        Outbox[]
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique @db.VarChar(64)
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  userAgent  String?   @db.VarChar(512)
  ipHash     String?   @db.VarChar(64)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model BalanceCategory {
  id                   String   @id @default(cuid())
  userId               String
  name                 String   @db.VarChar(80)
  slug                 String   @db.VarChar(64)
  color                String   @db.VarChar(16)
  icon                 String?  @db.VarChar(64)
  targetMinutesPerWeek Int      @default(0)
  sortOrder            Int      @default(0)
  isArchived           Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events Event[]
  goals  Goal[]

  @@unique([userId, slug])
  @@index([userId, isArchived, sortOrder])
}

model Goal {
  id           String     @id @default(cuid())
  userId       String
  categoryId   String?
  title        String     @db.VarChar(200)
  description  String?
  unit         String     @default("") @db.VarChar(32)
  currentValue Float      @default(0)
  targetValue  Float
  targetDate   DateTime?
  status       GoalStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category BalanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, status, targetDate])
  @@index([categoryId])
}

model Event {
  id                   String      @id @default(cuid())
  userId               String
  categoryId           String?
  calendarConnectionId String?
  title                String      @db.VarChar(200)
  description          String?
  location             String?     @db.VarChar(500)
  startAt              DateTime
  endAt                DateTime
  allDay               Boolean     @default(false)
  status               EventStatus @default(PLANNED)
  source               EventSource @default(MANUAL)
  externalId           String?     @db.VarChar(512)
  recurrenceRule       String?     @db.VarChar(1024)
  completedAt          DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category           BalanceCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  calendarConnection CalendarConnection? @relation(fields: [calendarConnectionId], references: [id], onDelete: SetNull)
  voiceCommand       VoiceCommand?

  @@unique([calendarConnectionId, externalId])
  @@index([userId, startAt, endAt])
  @@index([userId, status, startAt])
  @@index([categoryId, startAt])
}

model CalendarConnection {
  id                    String           @id @default(cuid())
  userId                String
  provider              CalendarProvider
  externalAccountId     String           @db.VarChar(255)
  accountEmail          String?          @db.VarChar(254)
  calendarId            String?          @db.VarChar(512)
  displayName           String?          @db.VarChar(200)
  feedUrlEncrypted      String?
  feedEtag              String?          @db.VarChar(512)
  feedLastModified      String?          @db.VarChar(512)
  feedContentHash       String?          @db.VarChar(64)
  feedSnapshotAt        DateTime?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  scopes                String[]         @default([])
  syncToken             String?
  lastSyncedAt          DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events Event[]

  @@unique([userId, provider, externalAccountId])
  @@index([userId, provider])
}

model GoogleCalendarConfig {
  id                    String   @id @default(cuid())
  userId                String   @unique
  clientId              String   @db.VarChar(512)
  clientSecretEncrypted String
  redirectUri           String?  @db.VarChar(2048)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VoiceCommand {
  id             String             @id @default(cuid())
  userId         String
  eventId        String?            @unique
  transcript     String?
  audioObjectKey String?            @db.VarChar(1024)
  parsedPayload  Json?
  confidence     Float?
  errorMessage   String?
  status         VoiceCommandStatus @default(RECEIVED)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(100)
  entityId    String?  @db.VarChar(191)
  metadata    Json?
  ipHash      String?  @db.VarChar(64)
  userAgent   String?  @db.VarChar(512)
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model Outbox {
  id            String       @id @default(cuid())
  userId        String?
  topic         String       @db.VarChar(150)
  aggregateType String       @db.VarChar(100)
  aggregateId   String       @db.VarChar(191)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, availableAt])
  @@index([userId, createdAt])
  @@index([aggregateType, aggregateId])
}
